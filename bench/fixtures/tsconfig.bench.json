{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["dom", "es2020", "es2018.promise", "ESNext.Intl"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "strict": true,
    "types": [],
    "noEmit": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/test.ts", "src/**/*.test.ts", "src/**/tests/**", "src/**/test/**"]
}
